    "@freellm/routing-core": "workspace:*",
    "@freellm/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^8.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
